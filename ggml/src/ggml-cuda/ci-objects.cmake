# Replace verified CI shard sources in their original link order.
function(ggml_cuda_ci_objects output)
    set(sources ${ARGN})
    if (GGML_CUDA_CI_OBJECTS_FILE)
        include("${GGML_CUDA_CI_OBJECTS_FILE}")
        list(LENGTH GGML_CUDA_CI_SOURCES n_sources)
        list(LENGTH GGML_CUDA_CI_OBJECTS n_objects)
        if (NOT n_sources GREATER 0 OR NOT n_sources EQUAL n_objects)
            message(FATAL_ERROR "Invalid CUDA CI object manifest")
        endif()
        set(result "")
        set(found 0)
        foreach(source IN LISTS sources)
            get_filename_component(absolute "${source}" ABSOLUTE BASE_DIR "${CMAKE_CURRENT_SOURCE_DIR}")
            list(FIND GGML_CUDA_CI_SOURCES "${absolute}" index)
            if (index LESS 0)
                list(APPEND result "${source}")
            else()
                list(GET GGML_CUDA_CI_OBJECTS ${index} object)
                if (NOT EXISTS "${object}")
                    message(FATAL_ERROR "Missing CUDA CI object: ${object}")
                endif()
                set_source_files_properties("${object}" PROPERTIES EXTERNAL_OBJECT TRUE GENERATED TRUE)
                list(APPEND result "${object}")
                math(EXPR found "${found} + 1")
            endif()
        endforeach()
        if (NOT found EQUAL n_sources)
            message(FATAL_ERROR "CUDA CI source coverage changed")
        endif()
        set(sources ${result})
    endif()
    set(${output} ${sources} PARENT_SCOPE)
endfunction()
